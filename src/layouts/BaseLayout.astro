---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  // Absolute or root-relative URL for the social/link preview image.
  // Falls back to the site-wide default below when a page doesn't set one.
  image?: string;
}
const {
  title,
  description = 'Datos curiosos e historias de videojuegos de los 80s, 90s y 2000s.',
  noindex = false,
  image = '/social-preview.png',
} = Astro.props;

const GTM_CONTAINER_ID = 'GTM-W2LWCQML';
---

<!doctype html>
<html lang="en">
  <head>
    {/*
      Google Tag Manager — pasted as high in <head> as possible, per Google's
      own install instructions. This replaces the old direct gtag.js +
      Consent Mode setup: we're testing via a brand-new Google Account
      (social@retromakers.com) and a GTM container instead, to isolate
      whether the "zero data" issue was specific to the previous account/setup.
      The actual GA4 config tag (measurement ID + trigger) is configured
      inside the GTM container itself at tagmanager.google.com, not here.
    */}
    {import.meta.env.PROD && (
      <script is:inline define:vars={{ GTM_CONTAINER_ID }}>
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', GTM_CONTAINER_ID);
      </script>
    )}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Retromakers</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="yDvVRkZk3PtPRH48mREonIVPuBi5YKhZGQP9qqVHdhY" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:title" content={`${title} · Retromakers`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {/* Google Tag Manager (noscript) — must be immediately after <body> */}
    {import.meta.env.PROD && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${GTM_CONTAINER_ID}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}
    <Header />
    <main class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
